<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nusc_tools</name>
  <version>0.0.1</version>
  <description>
    Python tools around nuScenes: dataset loader, detection simulator node,
    export of tracking results and evaluation helpers.
  </description>
  <maintainer email="239980864+richival01-web@users.noreply.github.com">Riccardo Valentini</maintainer>
  <license>MIT</license>

  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <!-- nuscenes-devkit and pyquaternion have no rosdep key: they are installed with pip in docker/Dockerfile. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
